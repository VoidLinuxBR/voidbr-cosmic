pkgname=voidbr-cosmic
pkgdesc="VoidBR COSMIC Meta Package"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
provides=()  # "eu SOU o $pkgname pkg1, pra quem depender deles"
replaces=()  # "remove o pkg1 pkg2 antigo automaticamente quando eu instalar"
conflicts=() # "nunca me deixe coexistir com o pkg1 pkg2 original"
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(
	# --- Base do VoidBR ---
	voidbr-base-common    # Base: base-config, utils, NetworkManager, firmware etc.
	voidbr-wayland-common # Wayland: xwayland, qt-wayland, seatd etc.
	voidbr-gui-common     # GUI: temas, fontes, pipewire, sddm, polkit-elogind etc.

	# --- COSMIC (receitas em voidbr-pkgmake/templates) ---
	cosmic-session        # Sessão; puxa comp, panel, applets, launcher, settings, bg,
	                      # notifications, osd, idle, randr, screenshot, workspaces,
	                      # files, icon-theme, greeter e xdg-desktop-portal-cosmic
	cosmic-terminal       # Terminal do COSMIC
	cosmic-text-editor    # Editor de texto do COSMIC
	cosmic-player         # Player de mídia do COSMIC
	cosmic-viewer         # Visualizador de imagens do COSMIC
	cosmic-monitor        # Monitor do sistema do COSMIC
	cosmic-store          # Loja (Flatpak) do COSMIC
	cosmic-wallpapers     # Papéis de parede do COSMIC
	cosmic-osk            # Teclado na tela

	# --- Integração ---
	power-profiles-daemon # Perfis de energia (applet de bateria)
	accountsservice       # Usuários no cosmic-settings
	flatpak               # Backend do cosmic-store
	voidbr-cosmic-config  # Skel config for Void Linux COSMIC Meta Package
)
backup=()

package() {
	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	elif [ -d "${srcdir}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}"
	else
		#local
		InternalDir="${WORKDIR}"
	fi

	cd "${InternalDir}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("boot" "etc" "opt" "usr" "var")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# Install license file if present
	[ -f "LICENSE" ] && install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	# Install documentation if present
	[ -f "README.md" ] && install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	if [ "${update:-}" = "yes" ]; then
		log "Finalizando upgrade"
	else
		log "Finalizando instalação"
	fi

	if [ -n "${MKISO_BUILD:-}" ]; then
		echo "${YELLOW}[-]${RESET} Build de ISO detectado (MKISO_BUILD) — pulando."
		return 0
	fi

	if [ -z "${VOIDBR_INSTALLER:-}" ]; then
		if [ -n "$user" ]; then
			log "Aplicando configuracoes para $user"
			/usr/local/bin/voidbr-copy-skel-inc --user "$user" --force --quiet || true
		fi

		log "Ativando serviços"
		/usr/local/bin/vservice add sddm --quiet || true
	fi

	log "${YELLOW}Instalação completa. Reinicie o sistema...${RESET}"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	post_install
}
